__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.venv/
build/
dist/
*.egg-info/

# OS / editor junk
.DS_Store

# Tooling state (regenerated; not part of the project)
.omc/
.bkit/
docs/.pdca-status.json
docs/.bkit-memory.json
# ``uv.lock`` is intentionally tracked: CI and manuscript reproduction use the exact
# dependency graph resolved for all supported Python versions.

# Generated scenario figure outputs (reproducible via cmm.app.* scenarios)
temp_figures/

# Large legacy expression data (58 MB, unused by any code/test)
test_data/log_tpm_qc.csv

# Generated scenario figure outputs written via CMM_OUTPUT_DIR (see docs/scenario-figures.md)
temp_figures_new/

# Workflow run directories. Neither workflow picks a location: output_dir is required and has
# no default (see docs/scenarios/_reporting.md), so this covers the conventional choice rather
# than an enforced one. These are the user's own analyses: raw CSVs, 300 DPI figures and the
# report. A single run is several megabytes and belongs to whoever ran it.
results/

# Root-level timestamped run bundles (user-owned generated artifacts)
/SC-01_*/
/SC-01_*.zip
/SC-02_*/
/SC-02_*.zip
